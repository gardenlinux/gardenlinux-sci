#!/bin/sh
set -eu

# CirrOS' NoCloud datasource executes user-data as a shell script; it does not
# run cloud-init. Install the shared test key for the default cirros user.
home=/home/cirros
mkdir -p "$home/.ssh"
printf '%s\n' '${SSH_KEY}' > "$home/.ssh/authorized_keys"
chown -R cirros:cirros "$home/.ssh"
chmod 700 "$home/.ssh"
chmod 600 "$home/.ssh/authorized_keys"
