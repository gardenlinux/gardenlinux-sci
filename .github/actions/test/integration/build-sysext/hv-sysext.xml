<domain type='kvm'>
    <name>${HV_NAME}</name>
    <memory unit='GiB'>6</memory>
    <memoryBacking>
        <!-- virtiofs needs a shared memory backend. -->
        <source type='memfd' />
        <access mode='shared' />
    </memoryBacking>
    <vcpu>2</vcpu>
    <os>
        <type arch='x86_64'>hvm</type>
        <boot dev='hd' />
        <smbios mode='sysinfo' />
    </os>
    <sysinfo type='smbios'>
        <oemStrings>
            <entry>io.systemd.credential:system.hostname=${HV_NAME}</entry>
            <entry>io.systemd.credential:ssh.authorized_keys.root=${SSH_PUBLIC_KEY}</entry>
            <entry>io.systemd.credential:tmpfiles.extra=f+ /etc/hosts 0644 root root - 127.0.0.1 localhost\n192.168.122.2 hv1\n192.168.122.3 hv2\n</entry>
            <entry>io.systemd.credential:fstab.extra=sci-sysext-raws /run/extensions virtiofs ro 0 0
/run/extensions/verity.crt /run/verity.d/verity.crt none bind,ro,x-systemd.requires-mounts-for=/run/extensions,x-systemd.mkdir 0 0
</entry>
            <entry>io.systemd.credential:systemd.unit-dropin.multi-user.target=[Unit]
Wants=ssh.service systemd-sysext.service
</entry>
            <entry>io.systemd.credential:systemd.unit-dropin.systemd-sysext.service=[Service]
Environment=SYSTEMD_SYSEXT_IMAGE_POLICY=root=signed
</entry>
            <!-- Extension units arrive after the merge; only sysext is a hard dependency. -->
            <entry>io.systemd.credential:systemd.unit-dropin.ssh.service=[Unit]
After=systemd-sysext.service libvirtd.service openvswitch-switch.service
Requires=systemd-sysext.service

[Service]
ExecStartPre=/usr/bin/systemctl is-active --quiet systemd-sysext.service
ExecStartPre=/usr/bin/systemctl is-active --quiet libvirtd.service
ExecStartPre=/usr/bin/systemctl is-active --quiet openvswitch-switch.service
ExecStart=
ExecStart=/usr/sbin/sshd -D -oPermitRootLogin=yes $$SSHD_OPTS
</entry>
            <!-- On systemd 259 empty extra-unit credentials are newline-only files, not masks. -->
            <entry>io.systemd.credential:systemd.unit-dropin.ssh.socket=[Unit]
ConditionPathExists=!/etc/os-release
</entry>
            <entry>io.systemd.credential:systemd.unit-dropin.cloud-.service=[Unit]
ConditionPathExists=!/etc/os-release
</entry>
            <entry>io.systemd.credential:systemd.unit-dropin.cloud-.target=[Unit]
ConditionPathExists=!/etc/os-release
</entry>
            <entry>io.systemd.credential:systemd.unit-dropin.cloud-.socket=[Unit]
ConditionPathExists=!/etc/os-release
</entry>
            <entry>io.systemd.credential:systemd.unit-dropin.tgt.service=[Unit]
ConditionPathExists=!/etc/os-release
</entry>
        </oemStrings>
    </sysinfo>
    <features>
        <acpi />
    </features>
    <cpu mode='host-passthrough' check='none' migratable='on' />
    <devices>
        <disk type='file' device='disk'>
            <driver name='qemu' type='qcow2' />
            <source file='${DISK_PREFIX}/${HV_NAME}.qcow2' />
            <target dev='vda' bus='virtio' />
        </disk>
        <interface type='network'>
            <mac address='${MAC}' />
            <source network='${NETWORK}' />
            <model type='virtio' />
        </interface>
        <!-- Read-only signed sysext raws; the guest mounts them at /run/extensions (ro) via fstab. -->
        <filesystem type='mount' accessmode='passthrough'>
            <driver type='virtiofs' />
            <source dir='${EXPORT_DIR}' />
            <target dir='sci-sysext-raws' />
        </filesystem>
        <!-- Both hypervisors need the shared guest disk for live migration. -->
        <filesystem type='mount' accessmode='passthrough'>
            <driver type='virtiofs' />
            <source dir='/opt/guest-images' />
            <target dir='guest-images' />
        </filesystem>
        <memballoon model='virtio' />
        <console type='pty'>
            <target type='serial' port='0' />
        </console>
        <serial type='file'>
            <source path='/var/log/${HV_NAME}.log' />
            <target port='0' />
        </serial>
    </devices>
</domain>
