<domain type='kvm'>
    <name>${HV_NAME}</name>
    <memory unit='GiB'>6</memory>
    <memoryBacking>
        <!-- virtiofs needs a shared memory backend. -->
        <source type='memfd' />
        <access mode='shared' />
    </memoryBacking>
    <vcpu>2</vcpu>
    <os>
        <type arch='x86_64'>hvm</type>
        <kernel>${KERNEL}</kernel>
        <initrd>${INITRD}</initrd>
        <cmdline>root=PARTUUID=${ROOT_UUID} console=ttyS0 systemd.gpt_auto=0 audit=0 rw</cmdline>
        <boot dev='hd' />
    </os>
    <features>
        <acpi />
    </features>
    <cpu mode='host-passthrough' check='none' migratable='on' />
    <devices>
        <disk type='file' device='disk'>
            <driver name='qemu' type='qcow2' />
            <source file='${DISK_PREFIX}/${HV_NAME}.qcow2' />
            <target dev='vda' bus='virtio' />
        </disk>
        <interface type='network'>
            <mac address='${MAC}' />
            <source network='${NETWORK}' />
            <model type='virtio' />
        </interface>
        <!-- Read-only signed sysext raws; the guest mounts them at /run/extensions (ro) via fstab. -->
        <filesystem type='mount' accessmode='passthrough'>
            <driver type='virtiofs' />
            <source dir='${EXPORT_DIR}' />
            <target dir='sci-sysext-raws' />
        </filesystem>
        <memballoon model='virtio' />
        <console type='pty'>
            <target type='serial' port='0' />
        </console>
        <serial type='file'>
            <source path='/var/log/${HV_NAME}.log' />
            <target port='0' />
        </serial>
    </devices>
</domain>
