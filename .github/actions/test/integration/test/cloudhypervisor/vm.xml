<domain type='kvm'>
    <name>VM-CHV</name>
    <memory unit='GiB'>2</memory>
    <vcpu placement='static'>2</vcpu>
    <os>
        <type arch='x86_64' machine='pc'>hvm</type>
        <!-- see https://github.com/cloud-hypervisor/rust-hypervisor-firmware/issues/382 -->
        <kernel>/usr/share/cloud-hypervisor/CLOUDHV_EFI.fd</kernel>
    </os>
    <cpu mode='host-passthrough' check='none' migratable='on' />
    <devices>
        <disk type='file' device='disk'>
            <source file='/var/lib/libvirt/images/cirros.raw' />
            <target dev='hda' bus='virtio' />
        </disk>
        <disk type='file' device='cdrom'>
            <source file='/var/lib/libvirt/images/cirros-cloud-init-ds.iso' />
            <target dev='hdb' bus='virtio' />
            <readonly />
        </disk>
        <interface type='network'>
            <mac address='52:54:00:00:00:11' />
            <source network='default' />
            <model type='virtio' />
        </interface>
        <serial type='file'>
            <source path='/var/log/CHV.log' />
            <target port='0' />
        </serial>
    </devices>
</domain>

