{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "reviewers": [
    "team:sap-cloud-infrastructure-maintainers"
  ],
  "baseBranchPatterns": [
    "$default",
    "/^rel-\\d+-dev$/"
  ],
  "useBaseBranchConfig": "merge",
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)\\.github/actions/test/integration/(?:.*/)?action\\.ya?ml$/"
    ],
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/tests/**",
      "**/__fixtures__/**",
      "**/.mise/locks/**",
      "**/.config/mise/locks/**"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "gardenlinux/package-libvirt",
        "gardenlinux/package-cloud-hypervisor-gl",
        "gardenlinux/package-edk2-cloud-hypervisor-gl"
      ],
      "groupName": "SCI custom packages",
      "separateMajorMinor": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "Group GitHub Actions",
      "separateMajorMinor": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    }
  ]
}
