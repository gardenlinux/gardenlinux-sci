#!/usr/bin/env bash

set -Eeuo pipefail

# install custom packages
# TODO : these all should go in the repo

# all versions URL encoded
EDK2_VERSION="20260221+261014-1gl0+bp2150"

download_build_artefacts() {
  local url=$1
  local dest=$2
  echo "Downloading and extracting package from $url"
  wget -q "$url" -O - | xz -d | tar xf - -C "$dest"
  (
    cd "$dest"
    rm -f -- *dbgsym* *arm64* *.tar.xz || true
  )
}

version_to_debversion() {
  local version=$1
  # convert the rightmost + to ~
  echo "${version%+*}~${version##*+}"
}

mkdir -p /tmp/custompackages
for p in https://github.com/gardenlinux/package-edk2-cloud-hypervisor-gl/releases/download/$EDK2_VERSION/build.tar.xz.0000; do
  download_build_artefacts "$p" /tmp/custompackages
done

pushd /tmp/custompackages > /dev/null

ls -1
dpkg -i \
  edk2-cloud-hypervisor-gl*_amd64.deb

popd > /dev/null
rm -rf /tmp/custompackages
