#!/usr/bin/env bash

set -Eeuo pipefail

# install custom packages
# TODO : these all should go in the repo
LIBVIRT_VERSION="12.7.0+261014-1gl0+bp2150"
CLOUD_HYPERVISOR_VERSION="52.1+261014-1gl0+bp2150"

download_build_artefacts() {
  local url=$1
  local dest=$2
  echo "Downloading and extracting package from $url"
  wget -q "$url" -O - | xz -d | tar xf - -C "$dest"
  (
    cd "$dest"
    rm -f -- *dbgsym* *arm64* *.tar.xz || true
  )
}

version_to_debversion() {
  local version=$1
  # convert the rightmost + to ~
  echo "${version%+*}~${version##*+}"
}

mkdir -p /tmp/custompackages
for p in https://github.com/gardenlinux/package-libvirt/releases/download/$LIBVIRT_VERSION/build.tar.xz.0000 https://github.com/gardenlinux/package-cloud-hypervisor-gl/releases/download/$CLOUD_HYPERVISOR_VERSION/build.tar.xz.0000; do
  download_build_artefacts "$p" /tmp/custompackages
done

LIBVIRT_VERSION_DEB=$(version_to_debversion "$LIBVIRT_VERSION")
#CLOUD_HYPERVISOR_VERSION_DEB=$(version_to_debversion "$CLOUD_HYPERVISOR_VERSION")

pushd /tmp/custompackages > /dev/null
ls -1
dpkg -i \
  cloud-hypervisor-gl*_amd64.deb \
  "libvirt-common_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt0_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-common_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-config-network_${LIBVIRT_VERSION_DEB}_all.deb" \
  "libvirt-daemon-config-nwfilter_${LIBVIRT_VERSION_DEB}_all.deb" \
  "libvirt-daemon-driver-ch-gl_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-network_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-nodedev_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-nwfilter_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-secret_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage-disk_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage-iscsi-direct_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage-iscsi_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage-logical_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage-mpath_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage-scsi_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-driver-storage_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon-log_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-daemon_${LIBVIRT_VERSION_DEB}_amd64.deb" \
  "libvirt-clients_${LIBVIRT_VERSION_DEB}_amd64.deb"
popd > /dev/null
rm -rf /tmp/custompackages
