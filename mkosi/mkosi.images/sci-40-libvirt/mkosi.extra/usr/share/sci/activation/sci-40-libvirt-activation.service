[Unit]
Description=SCI libvirt activation (delivery-time kvm modules, identities, libvirtd)
After=systemd-sysext.service
Wants=systemd-sysext.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/sbin/modprobe kvm
ExecStart=-/usr/sbin/modprobe kvm_amd
ExecStart=-/usr/sbin/modprobe kvm_intel
ExecStart=/usr/bin/systemd-sysusers
ExecStart=/usr/bin/systemd-tmpfiles --create
ExecStart=/usr/bin/systemctl start libvirtd.service

[Install]
WantedBy=multi-user.target
